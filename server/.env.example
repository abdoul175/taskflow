# Copy to server/.env to customize local development.
# On Vercel, add these variables in Project Settings → Environment Variables.

# Port for the Express API
PORT=4000

# Postgres connection string. Leave unset locally to use the embedded PGlite
# database in server/data/pglite. In production (Vercel) this must point to a
# Neon Postgres database; the Vercel Neon integration sets it automatically.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional directory for the local embedded Postgres (PGlite)
# PGLITE_DATA_DIR=./data/pglite

# Set when the app is deployed behind a different public origin
# APP_ORIGIN=https://taskflow.example.com

# Public app URL used in emails when the request origin is unavailable
# APP_URL=https://taskflow.example.com

# Google sign-in (optional). Create an OAuth 2.0 Web client in Google Cloud
# Console and register the callback URL, e.g.
# http://localhost:4000/api/auth/google/callback
# The button stays hidden until both the client ID and secret are set.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-change-me
# Optional fixed callback URL (defaults to <app origin>/api/auth/google/callback)
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# SMTP for verification codes and password-reset links.
# Leave SMTP_HOST empty to print emails to the server console instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASS=change-me
# SMTP_FROM="Taskflow <no-reply@example.com>"

# Force secure cookies. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
