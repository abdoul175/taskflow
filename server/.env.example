# Copy to server/.env to customize (all values are optional).

# Port for the Express API
PORT=4000

# Where the SQLite database lives (defaults to server/data/taskflow.db)
# DATABASE_PATH=./data/taskflow.db

# Set when the app is deployed behind a different public origin
# APP_ORIGIN=https://taskflow.example.com

# Public app URL used in emails when the request origin is unavailable
# APP_URL=https://taskflow.example.com

# SMTP for verification codes and password-reset links.
# Leave SMTP_HOST empty to print emails to the server console instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASS=change-me
# SMTP_FROM="Taskflow <no-reply@example.com>"

# Force secure cookies. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
